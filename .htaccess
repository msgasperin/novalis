Options +FollowSymLinks
RewriteEngine on

RewriteRule ^inicio index.php
RewriteRule ^webapp/admin webapp/admin.php
RewriteRule ^webapp/reportes/ticket$ webapp/reportes/ticket_pdf.php
RewriteRule ^webapp/reportes/corte$ webapp/reportes/ticket_corte_caja.php

RewriteRule ^webapp/guia1 webapp/test_guia1.php
RewriteRule ^webapp/guia5 webapp/test_guia5.php
RewriteRule ^webapp/plataforma webapp/plataforma.php
RewriteRule ^webapp/reportes/visor_resultados webapp/reportes/visor_resultados.php

# ── Headers de seguridad HTTP ────────────────────────────────
<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    Header always set Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' 'unsafe-inline' 'unsafe-eval'; \
        style-src 'self' 'unsafe-inline'; \
        img-src 'self' data:; \
        font-src 'self'; \
        connect-src 'self'; \
        frame-src 'self' blob:; \
        frame-ancestors 'self';"
</IfModule>
# ─────────────────────────────────────────────────────────────